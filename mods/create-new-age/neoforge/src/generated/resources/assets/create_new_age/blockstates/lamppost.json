{
  "multipart": [
    {
      "apply": {
        "model": "create_new_age:block/lamppost/pole"
      }
    },
    {
      "apply": {
        "model": "create_new_age:block/lamppost/top"
      },
      "when": {
        "top": "true"
      }
    },
    {
      "apply": {
        "model": "create_new_age:block/lamppost/bottom"
      },
      "when": {
        "bottom": "true",
        "east": "false",
        "north": "false",
        "south": "false",
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "create_new_age:block/lamppost/center"
      },
      "when": {
        "OR": [
          {
            "north": "true"
          },
          {
            "east": "true"
          },
          {
            "south": "true"
          },
          {
            "west": "true"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "create_new_age:block/lamppost/side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "create_new_age:block/lamppost/side",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "create_new_age:block/lamppost/side",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "create_new_age:block/lamppost/side",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    }
  ]
}